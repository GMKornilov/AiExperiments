FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/brewmark-mcp-server ./cmd/brewmark-mcp-server

FROM alpine:3.21
RUN apk add --no-cache wget && addgroup -S app && adduser -S -G app app
COPY --from=build /out/brewmark-mcp-server /usr/local/bin/brewmark-mcp-server
USER app
EXPOSE 8080
CMD ["brewmark-mcp-server"]
