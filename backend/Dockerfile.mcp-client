FROM golang:1.24-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/brewmark-mcp-client ./cmd/brewmark-mcp-client

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=build /out/brewmark-mcp-client /usr/local/bin/brewmark-mcp-client
ENTRYPOINT ["/usr/local/bin/brewmark-mcp-client"]
