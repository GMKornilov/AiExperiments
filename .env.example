# Локальные секреты для backend YAML.
SECURE_API_KEY=

# BrewMark MCP server. API token необязателен: пустое значение не добавляет
# Authorization к upstream-запросам.
BREWMARK_BASE_URL=https://brewmark.io
BREWMARK_API_TOKEN=
BREWMARK_REQUEST_TIMEOUT=10s
MCP_ADDR=127.0.0.1:8080
MCP_PORT=8081
MCP_ALLOWED_ORIGINS=http://localhost:3000
